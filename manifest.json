{
  "manifest_version": 3,
  "name": "d4te: Deadline Visualizer",
  "version": "1.0.3",
  "description": "Chromium-based browser extension aid for ADHD time-blind people. Offline, accessible and color-coded deadline visualizer.",
  "permissions": ["storage", "contextMenus"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "d4te: Deadline Visualizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
