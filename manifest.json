{
  "manifest_version": 3,
  "name": "d4te",
  "version": "1.1.0",
  "description": "Deadline tracker with a car-style fuel gauge on your new tab. Fully local, no login.",
  "permissions": ["storage", "contextMenus"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "d4te",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
